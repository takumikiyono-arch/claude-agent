# Slack Mention Reminder — 環境変数テンプレート
# このファイルを .env にコピーしてトークンを設定してください:
#   cp .env.template .env
#   vi .env

# Slack Bot/User OAuth Token (xoxp-... or xoxb-...)
# 必要なスコープ: channels:history, groups:history, reactions:read,
#                conversations.connect:read, im:write, chat:write
SLACK_BOT_TOKEN=xoxp-your-token-here
